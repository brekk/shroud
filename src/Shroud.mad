import type { Wish } from "Wish"

import Fn from "Function"
import IO from "IO"
import Process from "Process"
import { join } from "String"
import Wish from "Wish"

import Log from "@/Log"



export alias CommandWish = Wish Process.CommandResult Process.CommandResult
executeWithOptions :: Process.CommandOptions -> String -> List String -> CommandWish
export executeWithOptions = (opts, cmd, args) => {
  summary = `${IO.green(cmd)} ${IO.yellow(join(" ", args))}`
  return pipe(
    Log.env.run(summary),
    Process.exec($, args, opts),
  )(cmd)
}
execute :: String -> List String -> CommandWish
export execute = executeWithOptions(Process.DEFAULT_COMMAND_OPTIONS)
export run = execute
// of which do you speak?
export which = execute("which")
export exists = (exe) => pipe(
  of,
  which,
  map(
    pipe(
      .exitCode,
      Fn.equals(0),
    ),
  ),
  Wish.chainRej(
    pipe(
      .exitCode,
      Fn.equals(0),
      Wish.good,
    ),
  ),
  bimap(Log.env.shroud(exe ++ " doesn't exist"), Log.env.shroud(exe ++ " exists")),
)(exe)
export littleDeath = (cmd, _) => {
  failstring = "Command '" ++ cmd ++ "' does not exist"
  return { exitCode: 1, stderr: failstring, stdout: failstring }
}
// it's like execute, but like, slower and safer and better for your knees
killSoftlyWithOptions :: Process.CommandOptions
  -> (String -> List String -> Process.CommandResult)
  -> String
  -> List String
  -> CommandWish
export killSoftlyWithOptions = (opts, processFailCase, cmd, args) => pipe(
  exists,
  chain(
    (valid) => if (valid) {
      executeWithOptions(opts, cmd, args)
    } else {
      Wish.bad(processFailCase(cmd, args))
    },
  ),
)(cmd)
export coverWith = killSoftlyWithOptions
export walk = killSoftlyWithOptions(Process.DEFAULT_COMMAND_OPTIONS, littleDeath)
export cover = walk
